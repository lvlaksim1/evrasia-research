<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#F4C35A</item>
        <item name="android:navigationBarColor">#081310</item>
        <item name="android:statusBarColor">#081310</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="alertDialogTheme">@style/AppAlertDialogTheme</item>
    </style>

    <style name="AppAlertDialogTheme" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:windowMinWidthMajor">97%</item>
        <item name="android:windowMinWidthMinor">97%</item>
    </style>
</resources>
